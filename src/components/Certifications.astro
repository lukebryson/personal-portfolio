---
const certs = [
  { code: 'PL-900', name: 'Power Platform Fundamentals', url: 'https://learn.microsoft.com/api/credentials/share/en-us/LukeBryson-4423/43419196C529DCA0?sharingId=1A27609688BD495', passed: true },
  { code: 'AI-901', name: 'Azure AI Fundamentals', url: 'https://learn.microsoft.com/api/credentials/share/en-us/LukeBryson-4423/40CD3D0D308736BB?sharingId=1A27609688BD495', passed: true },
  { code: 'PL-200', name: 'Power Platform Functional Consultant', url: 'https://learn.microsoft.com/api/credentials/share/en-us/LukeBryson-4423/C964EAAA8245970C?sharingId=1A27609688BD495', passed: true },
  { code: 'AB-410', name: 'Intelligent App Builder', url: 'https://learn.microsoft.com/api/credentials/share/en-us/LukeBryson-4423/6235AF65AA683622?sharingId=1A27609688BD495', passed: true },
  { code: 'AB-620', name: 'AI Agent Builder', url: 'https://learn.microsoft.com/api/credentials/share/en-us/LukeBryson-4423/C12A07B35DCA44DD?sharingId=1A27609688BD495', passed: true },
  { code: 'PL-400', name: 'Power Platform Developer', url: 'https://learn.microsoft.com/en-us/credentials/certifications/power-platform-developer-associate/?practice-assessment-type=certification', passed: false, progress: 62 },
];
---

<section class="certs" id="certs">
  <div class="inner">
    <div class="certs-head" data-reveal>
      <div>
        <p class="eyebrow">Certifications</p>
        <h2 class="section-title">Microsoft Certified</h2>
      </div>
    </div>

    <div class="certs-grid">
      {certs.map((cert, i) => (
        <a
          class:list={['cert', { 'in-progress': !cert.passed }]}
          href={cert.url}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          data-delay={i * 90}
        >
          <div class="cert-top">
            <span class="cert-code">{cert.code}</span>
            <span class="cert-status">
              <span class="cert-dot" aria-hidden="true"></span>
              {cert.passed ? 'Passed' : 'In progress'}
            </span>
          </div>
          <p class="cert-name">
            <span>{cert.name}</span>
            <span class="cert-arrow" aria-hidden="true">↗</span>
          </p>
          {!cert.passed && (
            <div
              class="cert-track"
              role="progressbar"
              aria-label={`${cert.code} study progress`}
              aria-valuenow={cert.progress}
              aria-valuemin="0"
              aria-valuemax="100"
            >
              <div class="cert-fill" style={`width:${cert.progress}%`}></div>
            </div>
          )}
        </a>
      ))}
    </div>

    <div class="certs-extra" data-reveal>
      <span class="pill">
        <span class="pill-dot" aria-hidden="true"></span>
        Level 4 Software Engineer
        <span class="pill-status">In progress</span>
      </span>
    </div>
  </div>
</section>

<style>
  .certs {
    padding: 110px 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    background: var(--bg);
  }

  .certs-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
  }

  .certs-head .eyebrow {
    margin-bottom: 20px;
  }

  .certs-sub {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-faint);
    max-width: 280px;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px;
  }

  .cert {
    display: block;
    background: linear-gradient(180deg, #131316, #0e0e11);
    border: 1px solid var(--border-soft);
    border-radius: 14px;
    padding: 24px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .cert:hover {
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-3px);
  }

  .cert.in-progress:hover {
    border-color: rgba(196, 20, 20, 0.55);
  }

  .cert-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .cert-code {
    font: 700 24px/1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .cert-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cert-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--status-good);
  }

  .cert-name {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-faint);
  }

  /* Resting link affordance - mirrors the WorkCard arrow. */
  .cert-arrow {
    flex-shrink: 0;
    font-size: 15px;
    line-height: 1;
    color: var(--text-faint);
    transition:
      transform 0.25s ease,
      color 0.25s ease;
  }

  .cert:hover .cert-arrow,
  .cert:focus-visible .cert-arrow {
    transform: translate(3px, -3px);
    color: var(--accent-bright);
  }

  /* In-progress variant (PL-400) */
  .cert.in-progress {
    background: linear-gradient(180deg, #1a1214, #100c0d);
    border-color: rgba(196, 20, 20, 0.35);
  }

  .cert.in-progress .cert-status {
    color: var(--accent-bright);
  }

  .cert.in-progress .cert-dot {
    background: var(--accent-bright);
    box-shadow: 0 0 8px var(--accent);
  }

  .cert-track {
    margin-top: 16px;
    height: 4px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .cert-fill {
    height: 100%;
    border-radius: 4px;
    background: var(--accent);
  }

  .certs-extra {
    margin-top: 28px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 20px;
    border-radius: 100px;
    background: linear-gradient(180deg, #1a1214, #100c0d);
    border: 1px solid rgba(196, 20, 20, 0.35);
    font: 600 14px/1 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .pill-status {
    padding-left: 12px;
    border-left: 1px solid rgba(196, 20, 20, 0.35);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-bright);
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-bright);
    box-shadow: 0 0 8px var(--accent);
  }

  @media (max-width: 640px) {
    .certs {
      padding: 78px 22px;
    }
  }
</style>
