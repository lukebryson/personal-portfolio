---
const stats = [
  { value: '5×', label: 'Microsoft Certified' },
  { value: '3+ yrs', label: 'on the Power Platform' },
];
---

<section class="hero" id="top" data-spotlight>
  <canvas class="hero-canvas" data-particles aria-hidden="true"></canvas>
  <div class="hero-spot" data-spot aria-hidden="true"></div>

  <div class="hero-spacer" aria-hidden="true"></div>

  <div class="hero-content inner" data-parallax>
    <p class="eyebrow hero-eyebrow" data-reveal>Cloud Technical Engineer</p>
    <h1 class="hero-title" data-reveal data-delay="80">
      Luke Bryson<span class="dot">.</span>
    </h1>
    <p class="hero-sub" data-reveal data-delay="160">
      I work across SharePoint, the Power Platform and Microsoft's AI stack.
    </p>
    <div class="hero-stats" data-reveal data-delay="240">
      {stats.map(({ value, label }) => (
        <div class="stat">
          <span class="stat-value">{value}</span>
          <span class="stat-label">{label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* Bottom padding absorbs the space the scroll cue used to occupy
       (42px bar + 44px margin), so the hero composition is unchanged. */
    padding: 120px 40px 134px;
    overflow: hidden;
    background: radial-gradient(115% 120% at 82% -5%, #14141a 0%, #0a0a0c 55%);
  }

  .hero-canvas,
  .hero-spot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-canvas {
    opacity: 0.85;
  }

  .hero-spot {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .hero-spacer {
    flex: 1;
  }

  .hero-content {
    position: relative;
    width: 100%;
    z-index: 2;
  }

  .hero-eyebrow {
    letter-spacing: 0.34em;
    font-size: 13px;
    margin-bottom: 28px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(56px, 10vw, 140px);
    line-height: 0.9;
    letter-spacing: -0.035em;
    padding-bottom: 0.18em;
    background: var(--silver-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-title .dot {
    color: var(--accent-bright);
  }

  .hero-sub {
    margin-top: 30px;
    max-width: 600px;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
    color: #a7a7b0;
  }

  .hero-stats {
    margin-top: 46px;
    display: flex;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    padding: 0 34px;
    border-left: 1px solid var(--border-mid);
  }

  .stat:first-child {
    padding-left: 0;
    border-left: none;
  }

  .stat-value {
    font: 700 32px/1 var(--font-display);
    color: var(--text-primary);
  }

  .stat-label {
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-faint);
    margin-top: 9px;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 100px 22px 126px;
    }

    .hero-stats {
      flex-direction: column;
      gap: 22px;
      margin-top: 38px;
    }

    .stat {
      padding: 0;
      border-left: none;
    }
  }
</style>
