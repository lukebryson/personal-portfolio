---
const year = 2026;
---

<section class="contact" id="contact" data-contact>
  <div class="contact-orb" aria-hidden="true"></div>

  <div class="contact-content">
    <div class="tilt-wrap">
      <img
        class="contact-logo"
        data-tilt
        src="/lb-logo.svg"
        alt="LB logo"
        width="120"
        height="120"
      />
    </div>

    <p class="eyebrow contact-eyebrow" data-reveal>Say hello</p>
    <h2 class="contact-title" data-reveal data-delay="80">Reach out anytime.</h2>
    <p class="contact-body" data-reveal data-delay="160">
      Feel free to reach out about anything SharePoint, Power Platform, or AI
      related.
    </p>

    <div class="contact-links" data-reveal data-delay="240">
      <a class="btn btn-primary" data-magnet href="mailto:lukeb73@outlook.com">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-10 6L2 7"></path>
        </svg>
        Email me
      </a>
      <a class="btn btn-secondary" data-magnet href="https://www.linkedin.com/in/luke-bryson-/" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.55V9h3.57v11.45Z"></path>
        </svg>
        LinkedIn
      </a>
      <a class="btn btn-secondary" data-magnet href="https://github.com/lukebryson" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path>
        </svg>
        GitHub
      </a>
    </div>

    <footer class="footer">
      <span class="footer-brand">
        <span class="footer-wordmark">Luke Bryson</span>
      </span>
      <span class="footer-copy">© {year} Luke Bryson · Cloud Technical Engineer</span>
    </footer>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 130px 40px 90px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    background: radial-gradient(
      120% 100% at 50% 120%,
      rgba(22, 16, 18, 0) 0%,
      var(--bg-alt) 40%
    );
  }

  .contact-orb {
    position: absolute;
    top: 44%;
    left: 50%;
    width: 640px;
    height: 640px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(196, 20, 20, 0.22), transparent 62%);
    transform: translate(-50%, -50%);
    animation: glowPulse 6s ease-in-out infinite;
    pointer-events: none;
  }

  .contact-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: 0 auto;
  }

  .tilt-wrap {
    perspective: 900px;
    display: inline-block;
    margin-bottom: 40px;
  }

  .contact-logo {
    filter: drop-shadow(0 18px 40px rgba(196, 20, 20, 0.35));
    transition: transform 0.15s ease-out;
  }

  .contact-eyebrow {
    letter-spacing: 0.3em;
    margin-bottom: 20px;
  }

  .contact-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 5.5vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    padding-bottom: 0.18em;
    background: linear-gradient(180deg, #ffffff, #9a9aa2);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: calc(20px - 0.18em);
  }

  .contact-body {
    max-width: 520px;
    font-size: 17px;
    line-height: 1.6;
    color: #a7a7b0;
    margin: 0 auto 44px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 56px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 500 14px/1 var(--font-body);
    border-radius: 100px;
    white-space: nowrap;
  }

  .btn-primary {
    color: #fff;
    background: var(--accent);
    padding: 15px 24px;
  }

  .btn-secondary {
    color: var(--text-primary);
    background: #141418;
    border: 1px solid var(--border-strong);
    padding: 15px 22px;
  }

  .footer {
    max-width: 1180px;
    margin: 0 auto;
    padding-top: 40px;
    border-top: 1px solid var(--border-faint);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-wordmark {
    font: 500 13px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .footer-copy {
    font-size: 12px;
    line-height: 1;
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .contact {
      padding: 90px 22px 64px;
    }

    .footer {
      justify-content: center;
      text-align: center;
    }
  }
</style>
